# Copy to .env and fill in — never commit the real .env

GCP_PROJECT_ID=
GCP_REGION=asia-south1

# Vertex AI
VERTEX_AI_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash

# Firestore
FIRESTORE_DATABASE=(default)

# Pub/Sub
PUBSUB_TOPIC_AGENT_JOBS=agent-jobs
PUBSUB_SUBSCRIPTION_AGENT_JOBS=agent-jobs-sub

# GitHub sandbox integration — token itself lives in Secret Manager, not here
GITHUB_SANDBOX_REPO=ssurekumar01111-hue/Northbridge-Retail-Co.
GITHUB_TOKEN_SECRET_NAME=github-sandbox-pat

# Gateway
GATEWAY_URL=http://localhost:8080
